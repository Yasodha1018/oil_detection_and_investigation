# Application
LIVE_MODE=false
DEBUG=false

# Copernicus / Sentinel Hub
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here
SATELLITE_PROVIDER=copernicus

# Ocean and Weather APIs (optional)
OCEAN_API_URL=https://api.example.com/ocean
OCEAN_API_KEY=your_ocean_api_key
WEATHER_API_URL=https://api.example.com/weather
WEATHER_API_KEY=your_weather_api_key

# AI Model
MODEL_PATH=models/oilspill_model.pth

# Database
DATABASE_URL=sqlite:///./maritrace.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173